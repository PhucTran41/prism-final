// Datasource and generator
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Models (minimal MVP subset)
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  projects  Project[] @relation("UserProjects")
  members   ProjectMember[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Project {
  id          Int             @id @default(autoincrement())
  ownerId     Int
  owner       User            @relation("UserProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus   @default(DRAFT)
  documents   Document[]
  members     ProjectMember[]
  epics       Epic[]
  stories     Story[]
  roadmapItems RoadmapItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, createdAt])
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String  // e.g. MEMBER, OWNER (flexible for future)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId])
}

model Document {
  id            Int          @id @default(autoincrement())
  projectId     Int
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String
  title         String
  latestVersion Int          @default(0)
  contentMd     String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@unique([projectId, type])
  @@index([projectId, updatedAt])
}

// Planning entities (structured)
model Epic {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String?   // e.g. M/S/C or P1..P3
  status      String?   // e.g. PLANNED, IN_PROGRESS
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  stories     Story[]

  @@index([projectId, updatedAt])
}

model Story {
  id           Int       @id @default(autoincrement())
  projectId    Int
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epicId       Int?
  epic         Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  acceptance   String?   @db.Text
  priority     String?
  status       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([projectId, updatedAt])
  @@index([epicId])
}

model RoadmapItem {
  id           Int       @id @default(autoincrement())
  projectId    Int
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  target       String?   // e.g. Q1-2026 or Month
  priority     String?
  status       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([projectId, updatedAt])
}


